+package io.github.kdroidfilter.seforimapp.features.bookcontent.ui.components
+
+import androidx.compose.foundation.background
+import androidx.compose.foundation.layout.Box
+import androidx.compose.foundation.layout.size
+import androidx.compose.runtime.getValue
+import androidx.compose.runtime.mutableStateOf
+import androidx.compose.runtime.setValue
+import androidx.compose.ui.Alignment
+import androidx.compose.ui.Modifier
+import androidx.compose.ui.geometry.Offset
+import androidx.compose.ui.graphics.Color
+import androidx.compose.ui.graphics.toPixelMap
+import androidx.compose.ui.platform.testTag
+import androidx.compose.ui.test.ExperimentalTestApi
+import androidx.compose.ui.test.captureToImage
+import androidx.compose.ui.test.onNodeWithTag
+import androidx.compose.ui.test.performMouseInput
+import androidx.compose.ui.test.v2.runComposeUiTest
+import androidx.compose.ui.unit.dp
+import org.jetbrains.jewel.intui.standalone.theme.IntUiTheme
+import org.jetbrains.jewel.ui.Orientation
+import kotlin.test.Test
+import kotlin.test.assertEquals
+import kotlin.test.assertTrue
+
+@OptIn(ExperimentalTestApi::class)
+class ResizeHandleTest {
+    @Test
+    fun `hover and drag feedback fades after releasing outside the handle`() {
+        for (orientation in listOf(Orientation.Vertical, Orientation.Horizontal)) {
+            runComposeUiTest {
+                setContent {
+                    IntUiTheme(isDark = false) {
+                        Box(Modifier.size(300.dp).background(Color.Black).testTag("container"), Alignment.Center) {
+                            ResizeHandle(
+                                orientation = orientation,
+                                showGlow = true,
+                                modifier =
+                                    Modifier
+                                        .size(
+                                            width = if (orientation == Orientation.Vertical) 7.dp else 240.dp,
+                                            height = if (orientation == Orientation.Vertical) 240.dp else 7.dp,
+                                        ).testTag("handle"),
+                            )
+                        }
+                    }
+                }
+                val handle = onNodeWithTag("handle")
+
+                fun centerBrightness(): Float {
+                    waitForIdle()
+                    mainClock.advanceTimeBy(200)
+                    val pixels = handle.captureToImage().toPixelMap()
+                    val color = pixels[pixels.width / 2, pixels.height / 2]
+                    return maxOf(color.red, color.green, color.blue)
+                }
+
+                assertEquals(0f, centerBrightness())
+                handle.performMouseInput { moveTo(center) }
+                val hoverBrightness = centerBrightness()
+                assertTrue(hoverBrightness > 0f)
+                val pixels = handle.captureToImage().toPixelMap()
+                assertEquals(Color.Black, pixels[0, 0], "The glow must stay clear of the island corners")
+
+                handle.performMouseInput { press() }
+                assertTrue(centerBrightness() > hoverBrightness)
+                // The resize library captures the pointer, so feedback must survive leaving the handle.
+                onNodeWithTag("container").performMouseInput { moveTo(Offset(10f, 10f)) }
+                assertTrue(centerBrightness() > 0f)
+                onNodeWithTag("container").performMouseInput { release() }
+                assertEquals(0f, centerBrightness())
+            }
+        }
+    }
+
+    @Test
+    fun `disabling feedback during a press clears it when enabled again`() =
+        runComposeUiTest {
+            var showGlow by mutableStateOf(true)
+            setContent {
+                IntUiTheme(isDark = false) {
+                    ResizeHandle(
+                        orientation = Orientation.Vertical,
+                        showGlow = showGlow,
+                        modifier = Modifier.size(7.dp, 240.dp).background(Color.Black).testTag("handle"),
+                    )
+                }
+            }
+            val handle = onNodeWithTag("handle")
+            handle.performMouseInput {
+                moveTo(center)
+                press()
+            }
+            runOnIdle { showGlow = false }
+            handle.performMouseInput {
+                release()
+                exit()
+            }
+            runOnIdle { showGlow = true }
+            waitForIdle()
+            mainClock.advanceTimeBy(200)
+            val pixels = handle.captureToImage().toPixelMap()
+            assertEquals(Color.Black, pixels[pixels.width / 2, pixels.height / 2])
+        }
+}
