-- Chrome-like bookmarks: one row per favorited target ("book:<id>" / "book:<id>:<tocEntryId>"),
-- optionally grouped into user-created folders.
CREATE TABLE IF NOT EXISTS favorite_folder (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    name TEXT NOT NULL,
    createdAt INTEGER NOT NULL
);

CREATE TABLE IF NOT EXISTS favorite (
    key TEXT NOT NULL PRIMARY KEY,
    bookId INTEGER NOT NULL,
    title TEXT NOT NULL,
    folderId INTEGER,
    createdAt INTEGER NOT NULL,
    tocEntryId INTEGER,
    lineId INTEGER
);

CREATE TABLE IF NOT EXISTS favorite_folder_membership (
    favoriteKey TEXT NOT NULL REFERENCES favorite(key) ON DELETE CASCADE,
    folderId INTEGER NOT NULL REFERENCES favorite_folder(id) ON DELETE CASCADE,
    PRIMARY KEY (favoriteKey, folderId)
);

CREATE INDEX IF NOT EXISTS favorite_membership_by_folder ON favorite_folder_membership(folderId);

migrateLegacyFolders:
INSERT OR IGNORE INTO favorite_folder_membership(favoriteKey, folderId)
SELECT key, folderId FROM favorite WHERE folderId IS NOT NULL;

clearLegacyFolders:
UPDATE favorite SET folderId = NULL WHERE folderId IS NOT NULL;

selectFavoriteFolderIds:
SELECT folderId FROM favorite_folder_membership WHERE favoriteKey = :key ORDER BY folderId;

selectFavoriteMemberships:
SELECT * FROM favorite_folder_membership;

addFavoriteToFolder:
INSERT OR IGNORE INTO favorite_folder_membership(favoriteKey, folderId)
SELECT favorite.key, favorite_folder.id FROM favorite, favorite_folder
WHERE favorite.key = :key AND favorite_folder.id = :folderId;

removeFavoriteFromFolder:
DELETE FROM favorite_folder_membership WHERE favoriteKey = :key AND folderId = :folderId;

clearFavoriteFolders:
DELETE FROM favorite_folder_membership WHERE favoriteKey = :key;

clearFolderMemberships:
DELETE FROM favorite_folder_membership WHERE folderId = :folderId;

upsertFavorite:
INSERT INTO favorite(key, bookId, title, folderId, createdAt, tocEntryId, lineId)
VALUES (:key, :bookId, :title, :folderId, :createdAt, :tocEntryId, :lineId)
ON CONFLICT(key) DO UPDATE SET
    title = excluded.title,
    lineId = excluded.lineId;

selectAllFavorites:
SELECT * FROM favorite ORDER BY createdAt DESC;

selectRecentFavorites:
SELECT * FROM favorite ORDER BY createdAt DESC LIMIT :maxRows;

selectRecentInFolder:
SELECT * FROM favorite WHERE key IN (
    SELECT favoriteKey FROM favorite_folder_membership WHERE folderId = :folderId
) ORDER BY createdAt DESC LIMIT :maxRows;

searchFavoritesByTitle:
SELECT * FROM favorite
WHERE title LIKE '%' || :query || '%' ESCAPE '\'
ORDER BY createdAt DESC;

countFavorite:
SELECT COUNT(*) FROM favorite WHERE key = :key;

selectFavoriteByKey:
SELECT * FROM favorite WHERE key = :key;

setFavoriteFolder:
UPDATE favorite SET folderId = :folderId WHERE key = :key;

deleteFavoriteByKey:
DELETE FROM favorite WHERE key = :key;

insertFolder:
INSERT INTO favorite_folder(name, createdAt) VALUES (:name, :createdAt);

lastInsertedFolderId:
SELECT last_insert_rowid();

selectFolders:
SELECT * FROM favorite_folder ORDER BY createdAt ASC;

deleteFolder:
DELETE FROM favorite_folder WHERE id = :id;

clearFolderFromFavorites:
UPDATE favorite SET folderId = NULL WHERE folderId = :folderId;
