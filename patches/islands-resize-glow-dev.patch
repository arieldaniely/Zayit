+package io.github.kdroidfilter.seforimapp.features.bookcontent.ui.components
+
+import androidx.compose.animation.core.animateFloatAsState
+import androidx.compose.animation.core.tween
+import androidx.compose.foundation.hoverable
+import androidx.compose.foundation.interaction.MutableInteractionSource
+import androidx.compose.foundation.interaction.collectIsHoveredAsState
+import androidx.compose.foundation.layout.Box
+import androidx.compose.runtime.Composable
+import androidx.compose.runtime.getValue
+import androidx.compose.runtime.mutableFloatStateOf
+import androidx.compose.runtime.mutableStateOf
+import androidx.compose.runtime.remember
+import androidx.compose.runtime.setValue
+import androidx.compose.ui.Modifier
+import androidx.compose.ui.draw.drawWithCache
+import androidx.compose.ui.geometry.Offset
+import androidx.compose.ui.graphics.Brush
+import androidx.compose.ui.input.pointer.PointerEventPass
+import androidx.compose.ui.input.pointer.PointerEventType
+import androidx.compose.ui.input.pointer.isPrimaryPressed
+import androidx.compose.ui.input.pointer.pointerInput
+import androidx.compose.ui.unit.dp
+import org.jetbrains.jewel.foundation.theme.JewelTheme
+import org.jetbrains.jewel.ui.Orientation
+import kotlin.math.abs
+
+/**
+ * Visual feedback for a splitter handle. [orientation] describes the divider, not the drag axis.
+ * Observes pointer events without consuming them; the split-pane library owns resizing.
+ */
+@Composable
+internal fun ResizeHandle(
+    orientation: Orientation,
+    showGlow: Boolean,
+    modifier: Modifier = Modifier,
+) {
+    if (!showGlow) {
+        Box(modifier)
+        return
+    }
+
+    val interactionSource = remember { MutableInteractionSource() }
+    val hovered by interactionSource.collectIsHoveredAsState()
+    var dragging by remember { mutableStateOf(false) }
+    var pointerPosition by remember { mutableFloatStateOf(Float.NaN) }
+    val intensity =
+        animateFloatAsState(
+            targetValue =
+                when {
+                    dragging -> 1f
+                    hovered -> 0.72f
+                    else -> 0f
+                },
+            animationSpec = tween(durationMillis = 140),
+            label = "Resize handle glow",
+        )
+    val accent = JewelTheme.globalColors.outlines.focused
+
+    Box(
+        modifier
+            .hoverable(interactionSource)
+            .pointerInput(orientation) {
+                try {
+                    awaitPointerEventScope {
+                        while (true) {
+                            val event = awaitPointerEvent(PointerEventPass.Initial)
+                            // Exit coordinates can be outside the handle; retain the last glow center.
+                            if (event.type != PointerEventType.Exit) {
+                                event.changes.firstOrNull()?.let { change ->
+                                    pointerPosition =
+                                        if (orientation == Orientation.Vertical) change.position.y else change.position.x
+                                }
+                            }
+                            if (event.type == PointerEventType.Press && event.buttons.isPrimaryPressed) {
+                                dragging = true
+                            } else if (!event.buttons.isPrimaryPressed) {
+                                dragging = false
+                            }
+                        }
+                    }
+                } finally {
+                    // Removing the handle or changing its orientation cancels pointer input.
+                    dragging = false
+                }
+            }.drawWithCache {
+                val vertical = orientation == Orientation.Vertical
+                val length = if (vertical) size.height else size.width
+                // Match the islands' 12dp corners and their axis-specific outer padding.
+                val inset = (12.dp + if (vertical) 6.dp else 4.dp).toPx().coerceAtMost(length / 2f)
+                val start = inset
+                val end = length - inset
+                val range = end - start
+                if (range <= 1f) {
+                    onDrawBehind {}
+                } else {
+                    val edgeFade = 28.dp.toPx().coerceAtMost(range / 2f)
+                    val rawCenter = if (pointerPosition.isFinite()) pointerPosition else length / 2f
+                    val center =
+                        if (range > edgeFade * 2f) {
+                            rawCenter.coerceIn(start + edgeFade, end - edgeFade)
+                        } else {
+                            (start + end) / 2f
+                        }
+                    val centerFraction = (center - start) / range
+                    val edgeFadeFraction = (edgeFade / range).coerceAtLeast(0.001f)
+                    val colors =
+                        List(17) { index ->
+                            val position = index / 16f
+                            val edgeProgress = (minOf(position, 1f - position) / edgeFadeFraction).coerceIn(0f, 1f)
+                            val smoothEdge = edgeProgress * edgeProgress * (3f - 2f * edgeProgress)
+                            val pointerProgress = 1f - (abs(position - centerFraction) / 0.62f).coerceIn(0f, 1f)
+                            val pointerGlow = 0.12f + 0.88f * pointerProgress * pointerProgress
+                            accent.copy(alpha = accent.alpha * smoothEdge * pointerGlow)
+                        }
+                    val brush =
+                        if (vertical) {
+                            Brush.verticalGradient(colors, startY = start, endY = end)
+                        } else {
+                            Brush.horizontalGradient(colors, startX = start, endX = end)
+                        }
+                    val crossCenter = if (vertical) size.width / 2f else size.height / 2f
+                    val lineStart = if (vertical) Offset(crossCenter, start) else Offset(start, crossCenter)
+                    val lineEnd = if (vertical) Offset(crossCenter, end) else Offset(end, crossCenter)
+                    val outerWidth = 14.dp.toPx()
+                    val innerWidth = 7.dp.toPx()
+                    val coreWidth = 2.dp.toPx()
+                    val hairlineWidth = 1.dp.toPx()
+
+                    onDrawBehind {
+                        // Read animation state only during drawing so frames reuse the cached brush.
+                        val alpha = intensity.value
+                        if (alpha > 0.01f) {
+                            drawLine(brush, lineStart, lineEnd, strokeWidth = hairlineWidth, alpha = alpha * 0.18f)
+                            drawLine(brush, lineStart, lineEnd, strokeWidth = outerWidth, alpha = alpha * 0.12f)
+                            drawLine(brush, lineStart, lineEnd, strokeWidth = innerWidth, alpha = alpha * 0.28f)
+                            drawLine(brush, lineStart, lineEnd, strokeWidth = coreWidth, alpha = alpha)
+                        }
+                    }
+                }
+            },
+    )
+}
